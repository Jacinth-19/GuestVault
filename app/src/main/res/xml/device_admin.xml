<?xml version="1.0" encoding="utf-8"?>
<!--
    Minimal policy set. GuestVault does not use these policies at runtime; they
    are only required for Device Owner provisioning, which enables optional
    per-app data clearing after a guest session.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
