<?xml version="1.0" encoding="utf-8"?>
<!--
    Window background shown by the OS while MainActivity starts.

    It mirrors the first frame of SplashScreen.kt exactly: a flat brand-indigo
    fill with the white shield mark centred, on the same baseline as the Compose
    splash. The old version used a gradient plus a white rounded tile, which
    flashed noticeably when the Compose splash took over.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_indigo" />
        </shape>
    </item>

    <item
        android:width="132dp"
        android:height="132dp"
        android:drawable="@drawable/ic_splash_logo"
        android:gravity="center" />
</layer-list>
